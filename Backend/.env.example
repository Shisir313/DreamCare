# Django Core Configuration
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-derma-care-nepal-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL for prod/docker, SQLite fallback for dev)
# DATABASE_URL=postgres://dermacare_user:dermacare_pass@localhost:5432/dermacare_db
DATABASE_URL=sqlite:///db.sqlite3

# Cache & Celery Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO S3 Compatible)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=dermacare-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Timezone & Regional Config
TIME_ZONE=Asia/Kathmandu
